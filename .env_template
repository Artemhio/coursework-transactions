# Пример конфигурации окружения для проекта coursework_transactions

# Базовый URL внешнего API (если используется)
EXTERNAL_API_BASE_URL=https://api.example.com

# Токен/ключ для доступа к API (заменить на реальный в .env)
EXTERNAL_API_TOKEN=your_api_token_here

# Уровень логирования приложения (DEBUG, INFO, WARNING, ERROR)
APP_LOG_LEVEL=INFO
